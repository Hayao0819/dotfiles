{
  "gh_writes": {
    "pr": [
      "create",
      "comment",
      "merge",
      "close",
      "edit",
      "review",
      "ready",
      "reopen",
      "update-branch"
    ],
    "issue": [
      "create",
      "comment",
      "close",
      "edit",
      "reopen",
      "delete",
      "lock",
      "unlock",
      "pin",
      "unpin",
      "transfer",
      "develop"
    ],
    "repo": [
      "create",
      "fork",
      "delete",
      "edit",
      "rename",
      "archive",
      "unarchive",
      "sync",
      "deploy-key"
    ],
    "release": [
      "create",
      "edit",
      "delete",
      "upload",
      "delete-asset"
    ],
    "gist": [
      "create",
      "edit",
      "delete",
      "rename"
    ],
    "workflow": [
      "run",
      "enable",
      "disable"
    ],
    "label": [
      "create",
      "edit",
      "delete",
      "clone"
    ],
    "secret": [
      "set",
